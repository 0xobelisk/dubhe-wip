# Public URL mapped to the Dokploy-exposed dubhe-channel service.
CHANNEL_PUBLIC_URL=https://channel-testnet.example.com
NUMERON_REPO_URL=https://github.com/0xobelisk/numeron-channel-mvp.git
NUMERON_REPO_REF=main

# Testnet Sui RPC for dubhe-channel submit/query execution.
DUBHE_CHANNEL_RPC_URL=https://rpc-testnet.suiscan.xyz/

# Shared-channel persistence keys.
DUBHE_CHANNEL_REDIS_PREFIX=dubhe:channel:numeron:testnet
DUBHE_CHANNEL_NATS_STREAM=DUBHE_CHANNEL
DUBHE_CHANNEL_NATS_SUBJECT_PREFIX=dubhe.channel

# Numeron dev/test wallet used by the browser client.
NEXT_PUBLIC_PRIVATE_KEY=suiprivkey_replace_me

# Keep the on-screen feed visible in testnet verification.
NEXT_PUBLIC_CHANNEL_FEED_UI=true
NEXT_PUBLIC_CHANNEL_VERBOSE_LOGS=true
NEXT_PUBLIC_REMOTE_INTENT_MOVE_DURATION_MS=56
NEXT_PUBLIC_FORCE_CHANNEL_SUBMIT=true
NEXT_PUBLIC_FAST_MOVE_DURATION_MS=48
NEXT_PUBLIC_CHANNEL_REGISTER_SENDER=
